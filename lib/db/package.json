{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "migrate:safe": "node ./scripts/migrate-safe.mjs",
    "migrate:verify-applied": "node ./scripts/verify-migrations-applied.mjs",
    "migrate:adopt-foundation": "node ./scripts/adopt-foundation-baseline.mjs",
    "test:migrate-adoption": "node ./scripts/test-foundation-adoption.mjs",
    "test:migrations": "node ./scripts/test-authorization-migrations.mjs",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4"
  }
}
